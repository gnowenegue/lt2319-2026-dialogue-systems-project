# Azure Speech Services
VITE_AZURE_SPEECH_KEY=your_azure_speech_key_here
VITE_AZURE_SPEECH_REGION=swedencentral

# Groq Cloud API (Recommended for fast speech NLU & NLG)
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-20b
VITE_GROQ_REFINER_MODEL=openai/gpt-oss-120b

# Gemini API (if using Google GenAI)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector DB
VITE_QDRANT_URL=http://localhost
VITE_QDRANT_PORT=6333
